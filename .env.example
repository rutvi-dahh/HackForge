# Groq API Configuration
# Get your API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Vision model for extraction (Pass A). Verify the model exists at https://console.groq.com/docs/models
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional second vision model for Pass B (falls back to GROQ_MODEL if unset)
GROQ_MODEL_FALLBACK=

# Text model for city-tier classification (cheap, fast; no vision needed)
GROQ_TEXT_MODEL=llama3-8b-8192

# Application Configuration
SECRET_KEY=change-me-before-demo-receipt-graveyard-2026
FLASK_ENV=development
DATABASE_PATH=receipt_graveyard.db
